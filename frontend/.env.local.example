# Frontend env for `npm run dev`.  cp .env.local.example .env.local  and fill in.
# .env.local is gitignored — put REAL keys there, NOT in this example file.
#
# The Google Maps key is the only thing the demo needs here (for the basemap). The rest
# runs keyless; with no NEXT_PUBLIC_SUPABASE_URL the /login page shows a dev role picker.

# Google Maps JavaScript API key (enable "Maps JavaScript API" + billing in Google Cloud;
# add an HTTP-referrer restriction — this key ships in the browser bundle).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Only for real Supabase auth (blank -> dev role picker):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_API_URL=http://localhost:3000
API_URL=http://localhost:3000
