# Local dev: copy this file to .env (and/or .env.local for the frontend).
# Commit only .env.example — never commit .env or .env.*. Prod secrets live in
# GitHub Actions secrets, Vercel env vars, and Supabase config.

# Supabase Postgres/PostGIS DSN — used by the NestJS `pg` pool and the worker's psycopg2
DATABASE_URL=

# Supabase project URL (server-side) — used by the auth guard
SUPABASE_URL=
# Supabase project URL (client-side, exposed to the browser) — used by the frontend
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (server-side) — client auth
SUPABASE_ANON_KEY=
# Supabase anon key (client-side, exposed to the browser) — client auth
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — NestJS only: verify JWTs, admin ops, RLS bypass.
# Secret — never ship this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Groq API key — used by LlmService and the worker's schema_map.py for
# llama-3.3-70b-versatile (chat/explain/brief/alert/schema-map). Server-side only.
GROQ_API_KEY=

# Cloudflare R2 (S3-compatible) — used by NestJS's R2 client and the worker's r2.py
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Upstash Redis job queue URL — used by NestJS's Queue and the worker's main.py
REDIS_URL=

# Backend REST base URL, used by the frontend (public) and as the API's own base URL
NEXT_PUBLIC_API_URL=
API_URL=

# MapLibre style JSON URL used by the frontend's MapCanvas (free; no key required)
NEXT_PUBLIC_MAP_STYLE_URL=

# Allowed origins for NestJS CORS
FRONTEND_ORIGIN=

# Email providers for notification alerts (SNS replacement)
RESEND_API_KEY=
BREVO_API_KEY=

# Wazuh SIEM ingest host for the log shipper
WAZUH_HOST=

# SSH deploy target for GitHub Actions (pulls and runs GHCR images)
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_SSH_KEY=
